APP_ENV=production
LOG_LEVEL=INFO

TIMEZONE=Asia/Yakutsk

PLUSOFON_TOKEN=
PLUSOFON_CLIENT_ID=10553
PLUSOFON_NUMBER_ID=
PLUSOFON_NUMBER=
PLUSOFON_WEBHOOK_TOKEN=

GIGACHAT_API_BASE_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CA_BUNDLE=
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra

ALLOWED_PHONE_NUMBERS=79XXXXXXXXX,79YYYYYYYYY

MASTER_PIN=
AUTH_PIN=

DAILY_WARNING_THRESHOLD=5
MAX_CONTEXT_MESSAGES=8
DEFAULT_LATIN_MODE=off

SMS_PRICE_RUB=2.00

HTTP_TIMEOUT_SECONDS=15

# Optional: ADDS to the built-in "news" RSS feeds (TASS, RBC,
# Lenta.ru, YSIA) -- does not replace them. Comma-separated
# Name=https://url pairs. A name matching a built-in source
# replaces only that source's URL; any other name adds an extra
# feed; the other built-in feeds always stay. Every URL must be
# https://, with no userinfo/non-standard port, and its host must
# already be one of the built-in feeds' hosts (tass.ru,
# rssexport.rbc.ru, lenta.ru, ysia.ru) -- this variable can only
# repoint or add a feed on an already-allowed host, never a new
# one; onboarding a new outlet needs a code change in
# app/core/config.py. Leave empty to use only the built-in
# defaults. Feed URLs are never accepted from an SMS.
NEWS_RSS_FEEDS=